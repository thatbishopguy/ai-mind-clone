# Backend: copy applicable settings to backend/.env or export them.
APP_ENV=development
# Relative paths resolve from the backend process working directory.
DATABASE_URL=sqlite:///./data/ai_mind_clone.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend: place in frontend/.env.local only if overriding the default.
# Server-to-server proxy destination; keep browser requests same-origin.
API_BASE_URL=http://127.0.0.1:8000
# Optional direct browser API origin. Leave unset for the proxy (recommended).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
