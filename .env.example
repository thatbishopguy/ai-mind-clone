# Backend: copy applicable settings to backend/.env or export them.
APP_ENV=development
# Hosting requires both credentials, matching on frontend and backend.
# Use a strong unique password; never use NEXT_PUBLIC_ for secrets.
OWNER_USERNAME=
OWNER_PASSWORD=
# Relative paths resolve from the backend process working directory.
DATABASE_URL=sqlite:///./data/ai_mind_clone.db
# Hosted alternative: use Neon's supplied PostgreSQL URL with sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend: place in frontend/.env.local only if overriding the default.
# Server-to-server proxy destination; keep browser requests same-origin.
API_BASE_URL=http://127.0.0.1:8000
# Optional direct browser API origin. Leave unset for the proxy (recommended).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
